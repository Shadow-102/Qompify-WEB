  "version": "1.3.0",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --target=es2020 --outfile=docs/app.js --loader:.png=dataurl --loader:.ttf=dataurl --jsx=automatic --define:process.env.NODE_ENV='\"production\"'",
    "dev": "esbuild src/main.jsx --bundle --outfile=docs/app.js --loader:.png=dataurl --loader:.ttf=dataurl --jsx=automatic --watch",
